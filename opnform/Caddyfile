{
	admin off
	auto_https off
	persist_config off
	servers {
		# Railway's edge proxy is the only public way in, and it overwrites X-Real-IP and
		# X-Forwarded-For with the real client address, so take the client IP from there.
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

:{$PORT:8080} {
	request_body {
		max_size 64MB
	}

	# Railway terminates TLS at its edge; tell Laravel when the original request was HTTPS.
	map {http.request.header.X-Forwarded-Proto} {fwd_https} {
		https on
		default off
	}

	# Nuxt runtime icons are served by the client.
	handle /api/_nuxt_icon/* {
		reverse_proxy {$CLIENT_UPSTREAM}
	}

	# Laravel API: strip the /api prefix (same as the upstream nginx config).
	handle_path /api/* {
		vars api_uri {http.request.uri}
		root * /usr/share/nginx/html/public
		php_fastcgi 127.0.0.1:9000 {
			env REQUEST_URI {vars.api_uri}
			env REMOTE_ADDR {client_ip}
			env HTTPS {fwd_https}
		}
		file_server
	}

	# Other Laravel paths, passed through unchanged.
	@laravel path /open/* /local/temp/* /forms/assets/*
	handle @laravel {
		root * /usr/share/nginx/html/public
		php_fastcgi 127.0.0.1:9000 {
			env REMOTE_ADDR {client_ip}
			env HTTPS {fwd_https}
		}
		file_server
	}

	# Everything else is the Nuxt front end.
	handle {
		reverse_proxy {$CLIENT_UPSTREAM} {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
